    "Screen Recording access is available for Pin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf die Bildschirmaufnahme ist für Pin verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la grabación de pantalla está disponible para Pin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à l’enregistrement d’écran est disponible pour Pin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin で画面収録を利用できます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à Gravação de Tela está disponível para o Pin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к записи экрана доступен для Pin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin 已获得“屏幕录制”权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin 已取得「螢幕錄製」權限。"
          }
        }
      }
    },
    "Screen Recording access is required only for Pin. Set it up before using a selected-window mirror.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf die Bildschirmaufnahme wird nur für Pin benötigt. Richten Sie ihn ein, bevor Sie ein ausgewähltes Fenster spiegeln."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la grabación de pantalla solo es necesario para Pin. Configúralo antes de usar un espejo de una ventana seleccionada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à l’enregistrement d’écran est requis uniquement pour Pin. Configurez-le avant d’utiliser le miroir d’une fenêtre sélectionnée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録の許可は Pin にのみ必要です。選択したウインドウのミラーを使う前に設定してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à Gravação de Tela é necessário apenas para o Pin. Configure-o antes de usar um espelho da janela selecionada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к записи экрана нужен только для Pin. Настройте его перед использованием зеркала выбранного окна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“屏幕录制”权限仅用于 Pin。使用选中窗口的镜像前，请先完成设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「螢幕錄製」權限僅用於 Pin。使用選取視窗的鏡像前，請先完成設定。"
          }
        }
      }
    },
    "Screen Recording access was allowed, but CloseUp must be restarted before Pin can use it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf die Bildschirmaufnahme wurde erlaubt, aber CloseUp muss neu gestartet werden, bevor Pin ihn verwenden kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha permitido el acceso a la grabación de pantalla, pero debes reiniciar CloseUp para que Pin pueda usarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à l’enregistrement d’écran a été autorisé, mais CloseUp doit être redémarré avant que Pin puisse l’utiliser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録へのアクセスは許可されましたが、Pin で使うには CloseUp を再起動する必要があります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à Gravação de Tela foi permitido, mas é necessário reiniciar o CloseUp para que o Pin possa usá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к записи экрана разрешён, но перед использованием Pin необходимо перезапустить CloseUp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“屏幕录制”权限已允许，但 CloseUp 必须重新启动后，Pin 才能使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「螢幕錄製」權限已允許，但必須重新啟動 CloseUp，Pin 才能使用。"
          }
        }
      }
    },
    "Screen Recording access was denied. Allow it in System Settings to use Pin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf die Bildschirmaufnahme wurde abgelehnt. Erlauben Sie ihn in den Systemeinstellungen, um Pin zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha denegado el acceso a la grabación de pantalla. Permítelo en Ajustes del Sistema para usar Pin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à l’enregistrement d’écran a été refusé. Autorisez-le dans Réglages Système pour utiliser Pin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録へのアクセスが拒否されました。Pin を使うには「システム設定」で許可してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à Gravação de Tela foi negado. Permita-o nos Ajustes do Sistema para usar o Pin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В доступе к записи экрана отказано. Разрешите его в системных настройках, чтобы использовать Pin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“屏幕录制”权限已被拒绝。请在“系统设置”中允许访问，以使用 Pin。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「螢幕錄製」權限遭到拒絕。請在「系統設定」中允許存取，才能使用 Pin。"
          }
        }
      }
    },
    "Screen Recording access was revoked. Re-enable it to use Pin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf die Bildschirmaufnahme wurde widerrufen. Aktivieren Sie ihn erneut, um Pin zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha revocado el acceso a la grabación de pantalla. Vuelve a activarlo para usar Pin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à l’enregistrement d’écran a été révoqué. Réactivez-le pour utiliser Pin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面収録へのアクセスが取り消されました。Pin を使うには再度有効にしてください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à Gravação de Tela foi revogado. Ative-o novamente para usar o Pin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к записи экрана отозван. Включите его снова, чтобы использовать Pin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“屏幕录制”权限已被撤销。请重新开启后使用 Pin。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「螢幕錄製」權限已撤銷。請重新開啟後使用 Pin。"
